[Unit]
Description=Stage and test the latest CI-approved WhatsApp MCP release
OnSuccess=whatsapp-mcp-promote.service

[Service]
Type=oneshot
User=@STAGE_USER@
Group=@STAGE_GROUP@
SupplementaryGroups=@CANDIDATE_GROUP@
EnvironmentFile=/etc/whatsapp-mcp/updater.env
Environment=npm_config_cache=@STAGE_ROOT@/npm-cache
ExecStart=/usr/local/libexec/whatsapp-mcp-stage-ready-release
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=@STAGE_ROOT@ @CANDIDATE_ROOT@
InaccessiblePaths=-@RELEASE_ROOT@ -@PROMOTE_STATE_ROOT@ -@PERSONAL_STATE_ROOT@ -@PERSONAL_SECONDARY_STATE_ROOT@ -@BUSINESS_STATE_ROOT@ -@CREDENTIAL_ROOT@
PrivateDevices=yes
CapabilityBoundingSet=
MemoryMax=2G
CPUQuota=200%
TimeoutStartSec=30min
