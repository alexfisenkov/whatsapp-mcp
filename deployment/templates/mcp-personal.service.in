[Unit]
Description=WhatsApp MCP linked-device profile
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@PERSONAL_SERVICE_USER@
Group=@PERSONAL_SERVICE_GROUP@
SupplementaryGroups=@RELEASE_GROUP@
WorkingDirectory=@RELEASE_ROOT@/current
Environment=WHATSAPP_ADAPTER=linked-device
Environment=WHATSAPP_PROFILE_ID=personal-owner
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=@PERSONAL_MCP_LOOPBACK_PORT@
Environment=WHATSAPP_STATE_DIR=@STATE_ROOT@/personal
Environment=WHATSAPP_AUDIT_DB_PATH=@STATE_ROOT@/personal/audit.sqlite
Environment=WHATSAPP_HISTORY_DB_PATH=@STATE_ROOT@/personal/history.sqlite
Environment=WHATSAPP_MEDIA_DIR=@STATE_ROOT@/personal/media
EnvironmentFile=@PERSONAL_PRIVATE_ENV_FILE@
StateDirectory=@STATE_PREFIX@/personal
StateDirectoryMode=0700
RuntimeDirectory=@RUNTIME_PREFIX@/personal
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/node @RELEASE_ROOT@/current/dist/http-server.js
ExecStartPre=/usr/bin/install -d -m 0700 @STATE_ROOT@/personal/media
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=384M
CPUQuota=100%
ReadWritePaths=@STATE_ROOT@/personal @RUNTIME_ROOT@/personal

[Install]
WantedBy=multi-user.target
