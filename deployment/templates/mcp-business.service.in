[Unit]
Description=WhatsApp MCP Business Graph profile
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@BUSINESS_SERVICE_USER@
Group=@BUSINESS_SERVICE_GROUP@
SupplementaryGroups=@RELEASE_GROUP@
WorkingDirectory=@RELEASE_ROOT@/current
Environment=WHATSAPP_ADAPTER=business-graph
Environment=WHATSAPP_PROFILE_ID=business-owner
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=@BUSINESS_MCP_LOOPBACK_PORT@
Environment=WHATSAPP_STATE_DIR=@STATE_ROOT@/business
Environment=WHATSAPP_AUDIT_DB_PATH=@STATE_ROOT@/business/audit.sqlite
Environment=WHATSAPP_HISTORY_DB_PATH=@STATE_ROOT@/business/history.sqlite
Environment=WHATSAPP_MEDIA_DIR=@STATE_ROOT@/business/media
EnvironmentFile=@BUSINESS_PRIVATE_ENV_FILE@
StateDirectory=@STATE_PREFIX@/business
StateDirectoryMode=0700
RuntimeDirectory=@RUNTIME_PREFIX@/business
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/node @RELEASE_ROOT@/current/dist/http-server.js
ExecStartPre=/usr/bin/install -d -m 0700 @STATE_ROOT@/business/media
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=384M
CPUQuota=100%
ReadWritePaths=@STATE_ROOT@/business @RUNTIME_ROOT@/business

[Install]
WantedBy=multi-user.target
